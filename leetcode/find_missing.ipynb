   "source": [
    "class Solution:\n",
    "    def findMissingElements(self, nums: List[int]) -> List[int]:\n",
    "        mn, mx = min(nums), max(nums)\n",
    "        s = set(nums)\n",
    "        return [x for x in range(mn + 1, mx) if x not in s]\n",
    "    \n",
    "my_solution = Solution()\n",
    "print(my_solution.findMissingElements([1, 3, 5]))\n"
   ]
  }
 ],
